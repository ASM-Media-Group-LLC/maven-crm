# cloudphone-gateway — variables (cargar como SECRETOS en Dokploy, NUNCA en el repo ni en chat).

# Auth del agente MLX. Preferí el TOKEN (menos sensible que la password de la cuenta).
MLX_TOKEN=
# Alternativa si no hay token (puede chocar con 2FA):
MLX_EMAIL=
MLX_PASSWORD=

# Protege el endpoint de prueba /spike/capture (arrancar un teléfono gasta minutos de cloud).
SPIKE_TOKEN=

# Opcionales
PORT=8090
MLX_LAUNCHER_URL=https://launcher.mlx.yt:45001
