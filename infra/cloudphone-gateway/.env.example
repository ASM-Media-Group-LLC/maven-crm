# cloudphone-gateway — variables (cargar como SECRETOS en Dokploy, NUNCA en el repo ni en chat).

# --- Auth hacia Multilogin (elegí UNA de las dos formas) ---
# RECOMENDADO: el micro se auto-gestiona el token (signin -> automation token 8760h -> auto-refresh
#   si vence). Es la cuenta DUEÑA de Multilogin; la password es la real de la cuenta (el micro la md5'ea).
MLX_EMAIL=
MLX_PASSWORD=
# Alternativa manual: pegás un automation token largo (lo minteás con expiration_period=8760h) y lo
#   renovás vos (~1 año). Si seteás MLX_EMAIL+MLX_PASSWORD, este valor se ignora.
MLX_TOKEN=

# --- Auth del micro hacia Maven ---
# Protege TODOS los endpoints (header x-spike-token). Generá uno aleatorio largo.
SPIKE_TOKEN=

# --- Opcionales ---
PORT=8090
# MLX_CLOUD_URL=https://api.multilogin.com   # default
# MLX_TOKEN_TTL=8760h                         # expiración del automation token auto-minteado
