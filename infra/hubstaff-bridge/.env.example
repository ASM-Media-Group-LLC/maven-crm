# hubstaff-bridge — variables de entorno (en Dokploy: Environment / Secrets)

# Personal Access Token de Hubstaff (scope hubstaff:read). El string que devuelve la
# pantalla "Create token" es un REFRESH TOKEN — pegá ESE acá. Rota en cada refresh; el
# micro persiste el nuevo en la tabla hubstaff_secrets, así que esto es solo la SEMILLA.
HUBSTAFF_PAT_REFRESH_TOKEN=

# Supabase (mismos que el resto de micros). La service_role key NUNCA va al frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcionales (con defaults razonables):
LOOKBACK_DAYS=8          # ventana móvil de días que se re-sincroniza cada corrida
RUN_EVERY_HOURS=6        # cadencia del loop (el scorecard es mensual, no necesita tiempo real)
# RUN_ONCE=1             # corre una vez y sale (para probar)
# HUBSTAFF_PROBE=1       # NO sincroniza: solo imprime el shape crudo de la API para validar campos
