# ── Sesión de BLU (SECRETO — el JWT de TU sesión, lo rotás a mano cada ~24h) ──
# Sacalo de tu sesión de BLU y pegalo DIRECTO en el secreto de Dokploy (no en otro lado).
BLU_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── API de BLU ──
BLU_API_BASE=https://of.unlok.me          # confirmar host con BLU_PROBE (puede ser app.blu.luxe)
BLU_EARNINGS_PATH=/api/earnings           # CONFIRMAR el path exacto con BLU_PROBE
# BLU_WS_URL=wss://of.unlok.me/           # opcional: si el REST necesita un handshake WS de auth previo

# ── Maven (service_role — SECRETO) ──
SUPABASE_URL=https://lsagslbkliprespbyhts.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__service_role_key__

# ── Operación ──
LOOKBACK_DAYS=8
RUN_EVERY_HOURS=24
# BLU_PROBE=1   # recon: tantea host+endpoints con el JWT, loguea la forma del JSON y sale. Quitar después.
# RUN_ONCE=1    # corre una vez y sale con código != 0 si falla (para correr como cron/scheduled task).
