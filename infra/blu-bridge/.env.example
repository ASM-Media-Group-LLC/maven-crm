# ── Cognito de BLU (config PÚBLICA — del bundle de la app) ──
BLU_USER_POOL_ID=us-east-1_xxxxxxxxx
BLU_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Usuario de servicio de BLU (SECRETOS — idealmente un usuario dedicado, no el personal) ──
BLU_USERNAME=servicio@asmtech.me
BLU_PASSWORD=__poner_en_secretos_de_dokploy__

# ── API de BLU ──
BLU_API_BASE=https://app.blu.luxe
BLU_EARNINGS_PATH=/api/of-creator-reports   # CONFIRMAR con un request real

# ── Maven (service_role — SECRETO) ──
SUPABASE_URL=https://lsagslbkliprespbyhts.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__service_role_key__

# ── Operación ──
LOOKBACK_DAYS=8
RUN_EVERY_HOURS=24
