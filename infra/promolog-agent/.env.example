# Copiá a .env y completá. Corré con:  node --env-file=.env index.mjs
MAVEN_URL=https://lsagslbkliprespbyhts.supabase.co

# El MISMO token de la extensión (secret PROMOLOG_EXT_TOKEN de Supabase).
PROMOLOG_EXT_TOKEN=

# Las 2 cuentas scanner, una por slot. El slot define qué MITAD lee cada una.
SCANNER_SLOTS=a,b

# Pacing (conservador; el enemigo es el volumen por sesión). Opcionales.
# MIN_DELAY_MS=3500
# MAX_DELAY_MS=8000
# BATCH_EVERY=8
# BATCH_PAUSE_MS=20000
# MAX_PER_RUN=45
# SOFTBLOCK_STREAK=5
# COOLDOWN_HOURS=6

# HEADFUL=1  → ventana visible (para depurar o resolver un challenge en vivo)
