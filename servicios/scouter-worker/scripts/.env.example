# Migration script — kash Postgres → Maven Supabase.
# Copiá este archivo a `.env` (gitignored) y completá los valores reales.

# ── Origen: Postgres de kash en Dokploy ──────────────────────────────
# Mientras dure la migración, en Dokploy → Scouter-db → External Credentials
# habilitá el External Port (default 5432) y dale Save. Después de migrar,
# vovele a cerrar para no dejar la DB expuesta a internet.
#
# Formato:
#   postgres://<user>:<password>@<dokploy-host-ip>:<external-port>/<db-name>
#
# Ejemplo concreto para tu setup (con la IP del screenshot):
#   postgres://postgres:TUPASSWORD@217.216.95.7:5432/scouterdb
KASH_DATABASE_URL=postgres://postgres:REPLACE_ME@217.216.95.7:5432/scouterdb

# ── Destino: Maven Supabase ──────────────────────────────────────────
MAVEN_SUPABASE_URL=https://ygsjkbqpnrsbohygmhyw.supabase.co

# Service role key — Dashboard → Settings → API → service_role (secret).
# Tiene que ser la "service_role" no la "anon", para bypass-ear RLS.
MAVEN_SUPABASE_SERVICE_ROLE_KEY=eyJ...

# UUID del tenant destino. Para encontrarlo correr en SQL Editor:
#   select id, slug, name from tenants;
# Y copiar el id de ASM Tech (o el tenant donde quieras la data).
MAVEN_TENANT_ID=00000000-0000-0000-0000-000000000000
