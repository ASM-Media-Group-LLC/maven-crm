# Maven Scouter Worker — env vars.
# Copiá este archivo a `.env` y completá los valores reales.
# En Dokploy / Coolify setealos como Service Environment Variables.

# ── Supabase (servicio postgres + auth) ──────────────────────────────
SUPABASE_URL=https://ygsjkbqpnrsbohygmhyw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service role bypass-ea RLS, sólo en backend

# ── Apify (descubrimiento de leads) ──────────────────────────────────
APIFY_API_TOKEN=apify_api_...
# El "actor" que usamos para perfiles de Instagram. Default es el oficial
# pero podés cambiar a otro si tenés uno mejor calibrado.
APIFY_PROFILE_ACTOR=apify/instagram-profile-scraper
APIFY_HASHTAG_ACTOR=apify/instagram-hashtag-scraper

# Budget guard (si est_spend_usd del día > este valor el worker pausa).
APIFY_DAILY_BUDGET_USD=10
# Tope de items por run de Apify (cada item paga ~$0.0023 en estos actors).
APIFY_MAX_ITEMS_PER_RUN=50

# ── LLM scorer (Groq usado por consistencia con el resto del stack) ──
GROQ_API_KEY=gsk_...
# Modelo para AI scoring del lead. 8b alcanza bien para clasificar
# high_fit/medium_fit/low_fit; si querés más fino, llama-3.3-70b.
GROQ_SCORER_MODEL=llama-3.1-8b-instant

# ── Worker tuning ────────────────────────────────────────────────────
# Cada cuántos ms el worker hace polling de scouter_jobs.queued.
WORKER_POLL_INTERVAL_MS=15000
# Cuántos jobs procesa por tick (concurrencia 1 secuencial dentro del tick).
WORKER_BATCH_SIZE=3
# Failsafe: hard kill después de N segundos por job para no quedar colgado.
WORKER_JOB_TIMEOUT_MS=120000
