{
  "name": "scouter-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Maven Scouter worker — drena scouter_jobs queue (ScrapeCreators discovery + AI scoring de leads).",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "migrate:dry": "bun run scripts/migrate-from-kash.ts --dry-run",
    "migrate:apply": "bun run scripts/migrate-from-kash.ts --apply"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "typescript": "^5.4.0"
  }
}
