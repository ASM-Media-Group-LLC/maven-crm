# Servidor de edición compartida de la Oficina (infra/docs-sync).
#
# VACÍO a propósito: sin esto el editor funciona de a uno, que es el
# comportamiento correcto donde el servicio no está levantado. Para trabajar en
# local, poner la URL en frontend/.env.local (que NO se versiona), no acá.
#
# ⚠️ Vite tiene `root: "frontend"`, así que lee los .env de ESTA carpeta y no
# los de la raíz del repo. El .env de la raíz existe pero Vite no lo mira: en
# producción estas variables se inyectan al arrancar el contenedor.
VITE_DOCS_SYNC_URL=__RUNTIME_VITE_DOCS_SYNC_URL__
